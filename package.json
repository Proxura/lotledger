{
  "name": "lotledger",
  "version": "0.1.0",
  "private": true,
  "description": "LotLedger: recall-ready batch and lot records for small makers. Cloudflare Pages + Functions + D1.",
  "scripts": {
    "dev": "wrangler pages dev public --d1 DB=lotledger-db --compatibility-date=2026-10-01",
    "migrate:local": "wrangler d1 migrations apply lotledger-db --local",
    "migrate:remote": "wrangler d1 migrations apply lotledger-db --remote",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
